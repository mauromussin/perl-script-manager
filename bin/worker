#!/usr/bin/env perl
use strict;
use warnings;
use FindBin;
use lib "$FindBin::Bin/../lib";
use Mojolicious::Commands;

my $jobs = $ENV{SCRIPT_MANAGER_WORKER_JOBS} // 2;
die "SCRIPT_MANAGER_WORKER_JOBS non valido\n" unless $jobs =~ /\A[1-9]\d*\z/;

Mojolicious::Commands->start_app('ScriptManager', 'minion', 'worker', '-j', $jobs);
