# Copiare in .env (non versionato) e sostituire i valori.
APP_POSTGRES_USER=script_manager_app
APP_POSTGRES_PASSWORD=generate-a-new-local-password
APP_POSTGRES_DB=script_manager
APP_POSTGRES_PORT=5433
SCRIPT_MANAGER_SECRET=change-me-to-a-long-random-string
SCRIPT_MANAGER_WORKER_JOBS=2
# 1 abilita log INFO per ogni traccia e battuta; 0 registra solo le operazioni principali.
SCRIPT_MANAGER_DEBUG_OPERATIONS=0
# Cartella Windows contenente OUT: i nomi devono contenere un codice ICAO univoco.
FILE_OUT_ROOT=E:\FILE_OUT
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_USER=replace-with-mysql-user
MYSQL_PASSWORD=replace-with-mysql-password
# Il database MySQL viene scelto nel form, non in .env.
# Override opzionale; Compose usa docker.io/mauromussin/perl-script-manager:latest.
# Per fissare una versione, usare un tag sha-<commit>.
# APP_IMAGE=