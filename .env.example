# Copiare in .env (non versionato) e sostituire i valori.
APP_POSTGRES_USER=script_manager_app
APP_POSTGRES_PASSWORD=generate-a-new-local-password
APP_POSTGRES_DB=script_manager
APP_POSTGRES_PORT=5433
SCRIPT_MANAGER_SECRET=change-me-to-a-long-random-string
SCRIPT_MANAGER_WORKER_JOBS=2
# Override opzionale; Compose usa docker.io/mauromussin/perl-script-manager:latest.
# Per fissare una versione, usare un tag sha-<commit>.
# APP_IMAGE=