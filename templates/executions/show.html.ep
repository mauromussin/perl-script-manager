% layout 'default';
% title 'Esecuzione ' . substr($execution->{id}, 0, 8);
<h1><%= $execution->{procedure_name} %></h1>

<dl class="details">
  <dt>Identificatore</dt><dd><code><%= $execution->{id} %></code></dd>
  <dt>Stato</dt><dd><span class="status <%= $execution->{status} %>"><%= $execution->{status} %></span></dd>
% if (defined $execution->{queue_target}) {
  <dt>Coda database</dt><dd><%= $execution->{parameters}{database} %>
%   if (defined $execution->{queue_position}) {
    - posizione <%= $execution->{queue_position} %> (include l'eventuale richiesta in corso)
%   }
  </dd>
% }
  <dt>Avanzamento</dt>
  <dd>
% if (defined $execution->{progress} && $execution->{status} ne 'queued') {
    <progress max="100" value="<%= $execution->{progress} %>"></progress> <%= $execution->{progress} %>%
% } else {
    -
% }
    <%= $execution->{current_step} // '' %>
  </dd>
  <dt>Richiesta</dt><dd><%= $execution->{requested_at} %> da <%= $execution->{requested_by} %></dd>
  <dt>Inizio</dt><dd><%= $execution->{started_at} // '-' %></dd>
  <dt>Fine</dt><dd><%= $execution->{finished_at} // '-' %></dd>
% if (defined $execution->{summary}) {
  <dt>Esito</dt><dd><%= $execution->{summary} %></dd>
% }
% if (defined $execution->{error_message}) {
  <dt>Errore</dt><dd class="error"><%= $execution->{error_code} %>: <%= $execution->{error_message} %></dd>
% }
  <dt>Parametri</dt>
  <dd>
% for my $k (sort keys %{$execution->{parameters}}) {
    <div><strong><%= $k %></strong>: <%= ref $execution->{parameters}{$k} eq 'ARRAY' ? join(', ', @{$execution->{parameters}{$k}}) : $execution->{parameters}{$k} %></div>
% }
  </dd>
</dl>

% if ($execution->{timeout_bypassed}) {
<div class="alert" role="alert">
  <strong>Timeout disattivato per questa esecuzione con conferma utente.</strong>
  Non viene applicato il limite di durata configurato. La cancellazione resta disponibile;
% if ($execution->{procedure_code} eq 'carica_db') {
  in caso di interruzione verificare i log e l'esito del recupero prima di riprovare.
% } else {
  eventuali scritture gia eseguite non vengono annullate.
% }
</div>
% }
% if ($can_bypass_timeout) {
<div class="alert" role="alert">
% if (($execution->{error_code} // '') eq 'timeout_estimate_unavailable') {
  <strong>Durata non stimabile: manca uno storico misurabile. Vuoi rieseguire senza limite di tempo?</strong>
% } elsif (($execution->{error_code} // '') eq 'timed_out') {
  <strong>L'esecuzione precedente ha raggiunto il timeout configurato. Vuoi rieseguire senza limite di tempo?</strong>
% } else {
  <strong>La durata stimata supera il timeout. Vuoi rieseguire senza limite di tempo?</strong>
  <p>La stima e prudenziale, non una durata certa.</p>
% }
% if ($execution->{procedure_code} eq 'carica_db') {
  <p>La conferma crea una nuova richiesta in coda con gli stessi parametri e senza timeout.
    I file OUT saranno riletti e potrebbero essere cambiati. La riesecuzione non e idempotente:
    verificare prima nei log e nel database l'esito del rollback o recupero della richiesta precedente;
    dati gia pubblicati possono produrre ulteriori battute doppie.</p>
% } else {
  <p>La conferma crea una nuova richiesta
    nella coda con lo stesso database, le stesse date e la stessa scelta Sovrascrivi.
    Disattiva sia il blocco della stima sia il timeout reale, solo per la nuova esecuzione.
    Cancellazioni o errori possono lasciare scritture parziali.</p>
% }
  <form method="post" action="<%= url_for 'execution_timeout_bypass', id => $execution->{id} %>">
    <%= csrf_field %>
    <label><input type="checkbox" name="confirm_timeout_bypass" value="1" required>
      Confermo di voler disattivare il timeout per questa riesecuzione</label>
    <button type="submit">Conferma e riesegui senza timeout</button>
  </form>
</div>
% }
% if ($execution->{procedure_code} eq 'carica_db' && $execution->{status} eq 'timed_out'
%     && !$can_bypass_timeout && !$execution->{timeout_bypassed}) {
<div class="alert" role="alert">
  Riesecuzione senza timeout non disponibile: verificare nei log e nel database
  l'esito del commit o del recupero prima di procedere.
</div>
% }

<div class="actions">
% if ($execution->{procedure_code} eq 'correla_eventi_cmp' && $execution->{status} eq 'completed') {
  <a class="button" href="<%= url_for 'correlation_results', id => $execution->{id} %>">Verifica e attualizza LVA/LVAn</a>
% }
% if (!is_final($execution->{status}) && $execution->{status} ne 'cancel_requested') {
  <form method="post" action="<%= url_for 'execution_cancel', id => $execution->{id} %>">
    <%= csrf_field %>
    <button type="submit">Annulla</button>
  </form>
% }
  <a class="button" href="<%= url_for('procedure', code => $execution->{procedure_code})->query(from => $execution->{id}) %>">Riesegui</a>
</div>

<h2>File prodotti</h2>
% if (!@$artifacts) {
<p>Nessun file.</p>
% } else {
<ul>
%   for my $a (@$artifacts) {
  <li><a href="<%= url_for 'artifact', id => $execution->{id}, artifact_id => $a->{id} %>"><%= $a->{original_name} %></a>
    (<%= $a->{size_bytes} %> byte, sha256 <code><%= substr $a->{sha256}, 0, 12 %></code>)</li>
%   }
</ul>
% }

<h2>Log (ultimi 25 eventi)</h2>
<table class="log">
  <tbody>
% for my $ev (@$events) {
    <tr class="<%= $ev->{level} %>">
      <td><%= $ev->{created_at} %></td><td><%= uc $ev->{level} %></td><td><%= $ev->{message} %></td>
    </tr>
% }
  </tbody>
</table>
